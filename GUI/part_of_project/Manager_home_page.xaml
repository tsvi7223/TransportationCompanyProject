<Page x:Class="TransportationCompanyProject.GUI.NewFolder1.Manager_home_page"
    
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="ניהול מערכת - מנהל" Height="700" Width="1000"
      FlowDirection="RightToLeft"
      >

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0F172A" Padding="15,0">
            <Grid>
                <TextBlock Text="לוח בקרה - מנהל מערכת" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Content="ניהול כלי רכב" Background="#38BDF8" Foreground="White" Width="120" Height="35" Margin="5,0" BorderThickness="0"/>
                    <Button Content="רשימת לקוחות" Background="#475569" Foreground="White" Width="120" Height="35" Margin="5,0" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <TabControl Background="White" BorderBrush="#E2E8F0" BorderThickness="1">

                <TabItem Header="נהגים ממתינים לאישור (רישום)" Width="180" Height="30">
                    <Grid Margin="10">
                        <DataGrid x:Name="dgPendingDrivers" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="שם פרטי" Binding="{Binding fName}" Width="*"/>
                                <DataGridTextColumn Header="שם משפחה" Binding="{Binding lName}" Width="*"/>
                                <DataGridTextColumn Header="מספר רישיון" Binding="{Binding DriverLicenseNumber}" Width="*"/>
                                <DataGridTextColumn Header="טלפון" Binding="{Binding phoneNumber}" Width="*"/>
                                <DataGridTemplateColumn Header="פעולות" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="אישור" Background="#22C55E" Foreground="White" Width="60" Margin="2" Click="ApproveDriver_Click"/>
                                                <Button Content="דחייה" Background="#EF4444" Foreground="White" Width="60" Margin="2" Click="RejectDriver_Click"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="נסיעות בהמתנה לטיפול" Width="160">
                    <Grid Margin="10">
                        <DataGrid x:Name="dgPendingRides" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="קוד בקשה" Binding="{Binding Id}" Width="80"/>
                                <DataGridTextColumn Header="שם הלקוח" Binding="{Binding Customer.fName}" Width="*"/>
                                <DataGridTextColumn Header="כתובת איסוף" Binding="{Binding PickupAddress.City.CityName}" Width="*"/>
                                <DataGridTextColumn Header="כתובת יעד" Binding="{Binding DestinationAddress.City.CityName}" Width="*"/>
                                <DataGridTextColumn Header="מספר נוסעים" Binding="{Binding NumberOfPassengers}" Width="100"/>
                                <DataGridTemplateColumn Header="טיפול" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="שבץ נהג" Background="#38BDF8" Foreground="White" Height="25" Click="AssignDriver_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="היסטוריית נסיעות" Width="130">
                    <Grid Margin="10">
                        <DataGrid x:Name="dgHistoryRides" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderThickness="0" Background="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="תאריך" Binding="{Binding StartTime}" Width="*"/>
                                <DataGridTextColumn Header="נהג" Binding="{Binding Driver.fName}" Width="*"/>
                                <DataGridTextColumn Header="נוסע" Binding="{Binding RideRequest.Customer.fName}" Width="*"/>
                                <DataGridTextColumn Header="מחיר" Binding="{Binding Price}" Width="100"/>
                                <DataGridTextColumn Header="סטטוס" Binding="{Binding Status}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>

</Page>
