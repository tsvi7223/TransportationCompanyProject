<Page x:Class="TransportationCompanyProject.GUI.NewFolder1.Driver_home_page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="מסך עבודה לנהג" Height="700" Width="1000"
      FlowDirection="RightToLeft">

    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="שלום, " FontSize="18" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtDriverName" Text="ישראל הנהג" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <ToggleButton x:Name="btnStatusToggle" HorizontalAlignment="Left" VerticalAlignment="Center" Width="140" Height="40" Content="מצב: מחובר לעבודה" Background="#22C55E" Foreground="White" Click="StatusToggle_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" x:Name="brdActiveRideCard" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Margin="20,20,20,0" Padding="15" Visibility="Visible">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="🚨 נסיעה פעילה כעת בביצוע!" FontSize="16" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,5"/>
                    <TextBlock x:Name="txtActiveRideDetails" Text="איסוף: רחוב יפו 42, ירושלים  |  יעד: נמל התעופה בן גוריון" FontSize="14" Foreground="#1E3A8A"/>
                </StackPanel>
                <Button Grid.Column="1" Content="סמן כנסיעה שהושלמה ✅" Background="#3B82F6" Foreground="White" Padding="15,0" Height="40" VerticalAlignment="Center" Click="CompleteRide_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="לוח קריאות נסיעה זמינות לקבלה מיידית" Margin="0,0,10,0" Background="White" Padding="10">
                <DataGrid x:Name="dgAvailableRides" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="שעה" Binding="{Binding ScheduledTime}" Width="80"/>
                        <DataGridTextColumn Header="נקודת מוצא" Binding="{Binding PickupAddress.City.CityName}" Width="*"/>
                        <DataGridTextColumn Header="נקודת יעד" Binding="{Binding DestinationAddress.City.CityName}" Width="*"/>
                        <DataGridTemplateColumn Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="קח נסיעה" Background="#22C55E" Foreground="White" Height="25" Click="AcceptRide_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="היסטוריית העבודות שלי" Margin="10,0,0,0" Background="White" Padding="10">
                <DataGrid x:Name="dgDriverHistory" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="תאריך" Binding="{Binding EndTime}" Width="*"/>
                        <DataGridTextColumn Header="מסלול" Binding="{Binding RideRequest.DestinationAddress.City.CityName}" Width="*"/>
                        <DataGridTextColumn Header="רווח" Binding="{Binding Price}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </Grid>
</Page>


