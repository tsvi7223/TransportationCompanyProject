<Page x:Class="TransportationCompanyProject.GUI.NewFolder1.Customer_home_page"
     
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="מרכז נסיעות ללקוח" Height="700" Width="1000"
      FlowDirection="RightToLeft">

    <Grid Background="#F8FAFC">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1E293B" Padding="20">
            <StackPanel>
                <TextBlock Text="SmartTrack למטופל" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,30" HorizontalAlignment="Center"/>

                <Button Content="➕ הזמנת נסיעה חדשה" Background="#22C55E" Foreground="White" Height="45" Margin="0,10" BorderThickness="0" FontWeight="Bold" Click="NewRide_Click"/>
                <Button Content="❌ ביטול נסיעה נבחרת" Background="#EF4444" Foreground="White" Height="40" Margin="0,10" BorderThickness="0" Click="CancelRide_Click"/>
                <Button Content="👤 האזור האישי שלי" Background="#475569" Foreground="White" Height="40" Margin="0,30,0,10" BorderThickness="0" Click="PersonalArea_Click"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="הנסיעות הנוכחיות שלי (בטיפול / ממתינות)" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Foreground="#1E293B"/>

            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="10" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,20">
                <DataGrid x:Name="dgActiveOrders" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="תאריך מתוכנן" Binding="{Binding ScheduledTime}" Width="*"/>
                        <DataGridTextColumn Header="נקודת איסוף" Binding="{Binding PickupAddress.City.CityName}" Width="*"/>
                        <DataGridTextColumn Header="יעד" Binding="{Binding DestinationAddress.City.CityName}" Width="*"/>
                        <DataGridTextColumn Header="מספר נוסעים" Binding="{Binding NumberOfPassengers}" Width="100"/>
                        <DataGridTextColumn Header="מצב הבקשה" Binding="{Binding Status}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <TextBlock Grid.Row="2" Text="היסטוריית נסיעות אישית" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Foreground="#1E293B"/>

            <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="10" BorderBrush="#E2E8F0" BorderThickness="1">
                <DataGrid x:Name="dgCustomerHistory" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="תאריך" Binding="{Binding StartTime}" Width="*"/>
                        <DataGridTextColumn Header="נהג" Binding="{Binding Driver.fName}" Width="*"/>
                        <DataGridTextColumn Header="מסלול" Binding="{Binding RideRequest.PickupAddress.City.CityName}" Width="2*"/>
                        <DataGridTextColumn Header="עלות סופית" Binding="{Binding Price}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Page>


