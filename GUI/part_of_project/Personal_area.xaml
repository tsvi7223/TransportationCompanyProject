<Page x:Class="TransportationCompanyProject.GUI.part_of_project.Personal_area"
  
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="אזור אישי" Height="700" Width="1000"
      FlowDirection="RightToLeft">

    <Grid Background="#F8FAFC">
        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
            <StackPanel>
                <Ellipse Width="80" Height="80" Fill="#CBD5E1" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                <TextBlock Text="עדכון פרטים אישיים בפרופיל" FontSize="20" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <TextBlock Text="שם פרטי:" Margin="0,5,0,2" Foreground="#64748B"/>
                <TextBox x:Name="txtFirstName" Text="{Binding fName}" Height="35" VerticalContentAlignment="Center" IsReadOnly="True" Background="#F1F5F9"/>

                <TextBlock Text="שם משפחה:" Margin="0,10,0,2" Foreground="#64748B"/>
                <TextBox x:Name="txtLastName" Text="{Binding lName}" Height="35" VerticalContentAlignment="Center" IsReadOnly="True" Background="#F1F5F9"/>

                <TextBlock Text="מספר טלפון:" Margin="0,10,0,2" Foreground="#64748B"/>
                <TextBox x:Name="txtPhone" Text="{Binding phoneNumber}" Height="35" VerticalContentAlignment="Center" IsReadOnly="True" Background="#F1F5F9"/>

                <TextBlock Text="כתובת אימייל (Email):" Margin="0,10,0,2" Foreground="#64748B"/>
                <TextBox x:Name="txtEmail" Text="{Binding emailAddress}" Height="35" VerticalContentAlignment="Center" IsReadOnly="True" Background="#F1F5F9"/>

                <TextBlock Text="סיסמת מערכת:" Margin="0,10,0,2" Foreground="#64748B"/>
                <TextBox x:Name="txtPassword" Text="{Binding UserPassword}" Height="35" VerticalContentAlignment="Center" IsReadOnly="True" Background="#F1F5F9"/>

                <Grid Margin="0,25,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="btnEdit" Content="ערוך פרטים לפרופיל" Background="#38BDF8" Foreground="White" Height="40" Margin="0,0,5,0" BorderThickness="0" Click="Edit_Click"/>
                    <Button Grid.Column="1" x:Name="btnSave" Content="שמור שינויים בשרת" Background="#22C55E" Foreground="White" Height="40" Margin="5,0,0,0" BorderThickness="0" IsEnabled="False" Click="Save_Click"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Page>   
